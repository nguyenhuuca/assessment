MAX_HEAP=-Xmx256m
MIN_HEAP=-Xms50m

## JWT secret key
JWT_SECRET=12345678901234567890123456789012

## LOCAL DATABASE, default localhost
DB_USER=postgres
DB_NAME=funnyapp
DB_PASS=xx
DB_HOST=xxx
GOOGLE_KEY=xxx
GPT_KEY=xxx

OTEL_RESOURCE_ATTRIBUTES="xxx"
OTEL_EXPORTER_OTLP_ENDPOINT="xxx"
OTEL_EXPORTER_OTLP_HEADERS="xxx"
OTEL_EXPORTER_OTLP_PROTOCOL="http/protobuf"

## Grafana Cloud API (service account token, for dashboard/API management)
GRAFANA_URL=xxx
GRAFANA_SA_TOKEN=xxx

EMAIL_SENDER=xxx
EMAIL_PASS="xxx"

## SePay bank-transfer payments (ADR-0037). Leave the bank vars empty to keep donate/Premium hidden.
## Webhook URL to register on SePay: <API base>/v1/funny-app/webhooks/sepay (HMAC-SHA256 auth)
SEPAY_WEBHOOK_SECRET=xxx
SEPAY_BANK_ACCOUNT=xxx
SEPAY_BANK_CODE=xxx
SEPAY_ACCOUNT_NAME=xxx
## Optional (defaults shown)
SEPAY_CODE_PREFIX=FM
SEPAY_QR_BASE_URL=https://qr.sepay.vn/img
SEPAY_ORDER_TTL_HOURS=24
SEPAY_MIN_DONATION=10000
## Comma-separated IPs; keep empty behind a reverse proxy (HMAC already authenticates)
SEPAY_ALLOWED_IPS=
## Reconciliation job is deferred (PAY-5): keep false
SEPAY_API_TOKEN=
SEPAY_RECONCILE_ENABLED=false