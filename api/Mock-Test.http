### Drive sync - last 12 h (the tab default): ranged, so orphans are skipped
< {%
    client.global.set("from12h", new Date(Date.now() - 12 * 3600 * 1000).toISOString());
%}
GET {{api}}/admin/drive-sync/files?from={{from12h}}
Authorization: {{token}}

> {%
    client.test("12h listing skips orphans", () => {
        client.assert(response.status === 200, "status " + response.status);
        client.assert(response.body.data.orphansChecked === false, "orphansChecked " + response.body.data.orphansChecked);
    });
%}

### Drive sync - All: whole folder with the orphan check
GET {{api}}/admin/drive-sync/files
Authorization: {{token}}

> {%
    client.test("All listing checks orphans", () => {
        client.assert(response.status === 200, "status " + response.status);
        client.assert(response.body.data.orphansChecked === true, "orphansChecked " + response.body.data.orphansChecked);
        client.assert(Array.isArray(response.body.data.files), "files array");
    });
%}

### Drive sync - from after to is rejected
GET {{api}}/admin/drive-sync/files?from=2026-10-18T10:00:00Z&to=2026-10-18T09:00:00Z
Authorization: {{token}}

> {%
    client.test("from > to gives 400 invalidRange", () => {
        client.assert(response.status === 400, "status " + response.status);
        client.assert(response.body.error.code === "error.driveSync.invalidRange", "code " + response.body.error.code);
    });
%}

### Drive sync - current run
GET {{api}}/admin/drive-sync/runs/current
Authorization: {{token}}

> {%
    client.test("current run 200", () => client.assert(response.status === 200, "status " + response.status));
%}
