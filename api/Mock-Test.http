# Post-deploy API smoke test (IntelliJ HTTP Client format, also run by httpyac).
#
# Run after every deploy:   ./api/mock-test.sh              (env "prod")
#                           ENV=local ./api/mock-test.sh    (env "local", localhost:8081)
# host/prefix per env live in api/http-client.env.json. The script reads USER_CLAUDE_TEST /
# USER_CLAUDE_PASS from api/env.local (gitignored) and passes them as variables; nothing secret is stored here.
# In IntelliJ: pick the env, and put both keys in api/http-client.private.env.json (gitignored), e.g.
#   { "prod": { "USER_CLAUDE_TEST": "...", "USER_CLAUDE_PASS": "..." } }
#
# Rules: read-only requests only (GET + login). Never add a request that writes to prod data.
# The test account is ADMIN, not SUPER_ADMIN. When a new API ships, add its smoke request here.
# The backend reads the Authorization header as the raw JWT (no "Bearer " prefix).

@api = {{host}}{{prefix}}/v1/funny-app

### Health
GET {{host}}{{prefix}}/actuator/health

> {%
    client.test("health is UP", () => {
        client.assert(response.status === 200, "status " + response.status);
        client.assert(response.body.status === "UP", "body " + JSON.stringify(response.body));
    });
%}

### Admin API refuses anonymous calls
GET {{api}}/admin/drive-sync/files

> {%
    client.test("anonymous gets 401", () => {
        client.assert(response.status === 401, "status " + response.status);
    });
%}

### Auth options for the test account
GET {{api}}/user/auth-options?email={{USER_CLAUDE_TEST}}

> {%
    client.test("password login available", () => {
        client.assert(response.status === 200, "status " + response.status);
        client.assert(response.body.data.passwordLoginAvailable === true, "passwordLoginAvailable");
    });
%}

### Login (password) - saves the JWT for the requests below
POST {{api}}/user/login
Content-Type: application/json

{
  "email": "{{USER_CLAUDE_TEST}}",
  "password": "{{USER_CLAUDE_PASS}}"
}

> {%
    client.test("login succeeds as ADMIN", () => {
        client.assert(response.status === 200, "status " + response.status);
        client.assert(response.body.status === "SUCCESS", "status field " + response.body.status);
        client.assert(response.body.data.user.role === "ADMIN", "role " + response.body.data.user.role);
    });
    client.global.set("token", response.body.data.jwt);
%}

### Current user
GET {{api}}/user/me
Authorization: {{token}}

> {%
    client.test("me is the test account", () => {
        client.assert(response.status === 200, "status " + response.status);
        client.assert(response.body.data.role === "ADMIN", "role " + response.body.data.role);
    });
%}

